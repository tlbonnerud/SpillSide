{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spillside",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--bind",
        "127.0.0.1",
        "-d",
        "public"
      ],
      "port": 8080
    },
    {
      "name": "spillside-worker",
      "runtimeExecutable": "wrangler",
      "runtimeArgs": [
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    }
  ]
}
